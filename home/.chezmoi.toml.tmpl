{{- $mtShort := promptChoiceOnce . "machine_type" "Machine type (p=personal, w=work)" (list "p" "w") "p" -}}
{{- $machineType := "personal" -}}
{{- if eq $mtShort "w" -}}{{ $machineType = "work" }}{{- end -}}
{{- $email := "edwards.aaronmark@gmail.com" -}}
{{- $gitUsername := "aaron-edwards" -}}
{{- if eq $machineType "work" -}}
{{-   $email = promptStringOnce . "email" "Work email" $email -}}
{{-   $gitUsername = promptStringOnce . "git_username" "Git username" $gitUsername -}}
{{- end -}}
{{- $kde := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $kde = promptBoolOnce . "kde" "Install KDE Plasma theming" true -}}
{{- end }}

[data]
  name = "Aaron Edwards"
  email = {{ $email | quote }}
  git_username = {{ $gitUsername | quote }}
  machine_type = {{ $machineType | quote }}
  kde = {{ $kde }}

  packages = [
    "bitwarden-cli",
    "eza",
    "fd",
    "fzf",
    "mise",
    "neovim",
    "tree-sitter-cli",
    { yay ="github-cli", brew = "gh"},
    { aur = "ghostty", cask = "ghostty" },
    "ripgrep",
    "jq",
    "lazygit",
    { aur = "wl-clipboard" }, 
    "zoxide",
    "zsh",
    { aur = "zsh-antidote", brew = "antidote" },
    { aur = "otf-monaspace-nerd", brew = "font-monaspace-nerd-font" }
  ]

